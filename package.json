{
  "name": "cockpit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @b00dea/cockpit",
    "deps:refresh": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund && npm run bundle:rulesync --workspace @b00dea/cockpit && node scripts/supply-chain-check.ts --refresh-pins",
    "lint:docs": "tsx scripts/docs-lint.ts",
    "lint:markdown": "markdownlint-cli2",
    "lint:links": "git ls-files '*.md' | lychee --offline --include-fragments --no-progress --files-from -",
    "lint:supply-chain": "node scripts/supply-chain-check.ts",
    "references": "tsx scripts/references.ts",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:changed": "node scripts/run-changed-tests.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --build --singleThreaded"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "dependency-cruiser": "18.7.1",
    "markdownlint-cli2": "0.24.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "0.18.2",
    "re2js": "2.8.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
