{
  "name": "cockpit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @b0dea/cockpit",
    "lint:docs": "node scripts/docs-lint.mjs",
    "lint:supply-chain": "node scripts/supply-chain-check.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:changed": "node scripts/run-changed-tests.mjs",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
